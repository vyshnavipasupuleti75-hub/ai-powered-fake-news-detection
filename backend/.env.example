PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/veritydesk
# Default is srv and uses MONGODB_URI above. To explicitly use a verified standard Atlas URI,
# obtain the complete mongodb:// connection string from Atlas > Connect > Drivers first,
# put it in MONGODB_STANDARD_URI, then set MONGODB_CONNECTION_MODE=standard.
MONGODB_CONNECTION_MODE=srv
MONGODB_STANDARD_URI=
# Optional: comma-separated approved DNS resolver IPs for Node.js SRV lookups; leave blank unless needed.
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
# FastAPI service (classifier, OCR, video frames, speech). MEDIA_SERVICE_URL is preferred; AI_SERVICE_URL is an accepted alias.
MEDIA_SERVICE_URL=http://127.0.0.1:8000
# Optional: Google Fact Check Tools API key (enables published fact-check lookups)
EVIDENCE_API_KEY=
MAX_IMAGE_MB=8
MAX_VIDEO_MB=50
MEDIA_TIMEOUT_SECONDS=120
